<header class="site-header">
    <div class="site-header__container">
        <div class="site-header__right">
            {% include "navigation.njk" %}
        </div>
        <div id="langAlternatives">
            {%- set alternative = page.url | locale_links | alternateLinks(page.url, page.lang) %}
            {%- if alternative | length %}
            <p lang="{{ alternative[0].lang }}"><small><span class="visually-hidden">{%- if page.lang == 'it' %}This page is also available in English:{% else %}Questa pagina è disponibile anche in italiano:{% endif %} </span>
            {%- for link in alternative %}{% if not loop.first %}, {% endif %}<a href="{{link.url | url}}" lang="{{link.lang}}" hreflang="{{link.lang}}">{{link.label}}</a>{% endfor -%}
            </small></p>
            {%- endif %}
        </div>
    </div>
</header>
